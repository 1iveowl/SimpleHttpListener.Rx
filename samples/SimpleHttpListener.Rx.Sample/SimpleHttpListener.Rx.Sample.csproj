<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SimpleHttpListener.Rx/SimpleHttpListener.Rx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dogfooding: analyzer assets are private across a project reference, so the rules
         have to be asked for explicitly to apply to this project's own code. -->
