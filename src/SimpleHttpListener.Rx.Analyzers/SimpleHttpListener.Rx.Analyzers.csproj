<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers load into the compiler, which runs on netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>SimpleHttpListener.Rx.Analyzers</PackageId>
    <Description>Build-time analyzers for SimpleHttpListener.Rx: catches async subscribers passed to Rx Subscribe (SHLRX001) and leaked connections after an upgrade request (SHLRX002).</Description>
    <PackageTags>rx;reactive;analyzers;roslyn;http;listener</PackageTags>
    <!-- No lib output to symbolise, and an empty snupkg fails packing with NU5017. -->
    <IncludeSymbols>false</IncludeSymbols>

    <!-- Ships as an analyzer, not a library: nothing lands in the consumer's lib folder. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release tracking (RS2008): every shipped diagnostic ID is public API. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the tests can assert the names the rules match on against the real API. -->
    <InternalsVisibleTo Include="SimpleHttpListener.Rx.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)SimpleHttpListener.Rx.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The code fixes ship in this package but as their own assembly (RS1038 keeps the
      Workspaces layer out of an analyzer assembly). An ordinary reference builds them and
      drops the dll next to this one, which is where the None item above packs it from;
      PrivateAssets keeps it from becoming a dependency of anything.
    -->
    <ProjectReference Include="../SimpleHttpListener.Rx.Analyzers.CodeFixes/SimpleHttpListener.Rx.Analyzers.CodeFixes.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
