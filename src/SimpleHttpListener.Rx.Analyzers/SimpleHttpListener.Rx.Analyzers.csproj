<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers load into the compiler, which runs on netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!--
      Not published on its own. The assemblies this project builds are packed into
      SimpleHttpListener.Rx under analyzers/dotnet/cs, so consumers of the library get the
      rules with no second package to install, version or keep in step.
    -->
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release tracking (RS2008): every shipped diagnostic ID is public API. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the tests can assert the names the rules match on against the real API. -->
    <InternalsVisibleTo Include="SimpleHttpListener.Rx.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The code fixes are a separate assembly because RS1038 keeps the Workspaces layer out of
      an analyzer assembly. Referencing them here builds them alongside these rules; both
      assemblies are packed into SimpleHttpListener.Rx.
    -->
    <ProjectReference Include="../SimpleHttpListener.Rx.Analyzers.CodeFixes/SimpleHttpListener.Rx.Analyzers.CodeFixes.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
