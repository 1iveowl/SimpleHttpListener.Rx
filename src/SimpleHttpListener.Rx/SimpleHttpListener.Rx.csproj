<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SimpleHttpListener.Rx</PackageId>
    <Description>A simple Reactive Extensions (Rx) based HTTP listener for TCP, UDP and multicast, supporting HTTP keep-alive and SSDP-style datagrams.</Description>
    <PackageTags>http;listener;rx;reactive;observable;tcp;udp;multicast;ssdp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HttpMachine.PCL" Version="6.2.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Carries the analyzers to consumers as a package dependency. Everything but the
      analyzers asset is private: the analyzer assembly is a build-time tool, and letting its
      compile asset flow would make it an ordinary reference in every project downstream.
      That is wrong on its own, and enough to put Visual Studio's project system into
      LimitedFunctionality, because it then sees one project resolved two ways — as an
      analyzer and as an assembly.

      ReferenceOutputAssembly must stay at its default: setting it to false suppresses the
      package dependency altogether, which is the whole point of this reference. The cost is
      that this project alone compiles against the analyzer assembly without using it. The
      rules are applied to the samples and the test projects instead, which is where code
      resembling a consumer's actually lives.
    -->
    <ProjectReference Include="../SimpleHttpListener.Rx.Analyzers/SimpleHttpListener.Rx.Analyzers.csproj"
                      PrivateAssets="compile;runtime;native;contentfiles;build" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleHttpListener.Rx.Tests" />
  </ItemGroup>

</Project>
