<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SimpleHttpListener.Rx</PackageId>
    <Description>A simple Reactive Extensions (Rx) based HTTP listener for TCP, UDP and multicast, supporting HTTP keep-alive and SSDP-style datagrams.</Description>
    <PackageTags>http;listener;rx;reactive;observable;tcp;udp;multicast;ssdp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HttpMachine.PCL" Version="6.2.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The analyzers ship inside this package rather than as a dependency on one of their own.
      A dependency would have to carry the analyzer project into every consuming project's
      reference graph, where it resolves to no assembly at all — which Visual Studio reports
      as a broken reference (and, when its compile asset was allowed through, as
      LimitedFunctionality). Shipping the assemblies directly leaves nothing to resolve.

      PrivateAssets="all" and ReferenceOutputAssembly="false" reduce this to what it is: an
      instruction to build the analyzers first. Nothing about them reaches this assembly's
      references or the package's dependencies.
    -->
    <ProjectReference Include="../SimpleHttpListener.Rx.Analyzers/SimpleHttpListener.Rx.Analyzers.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both assemblies, because the code fixes live apart from the analyzers (rule RS1038) and
      the compiler loads whatever it finds in this folder.
    -->
    <None Include="../SimpleHttpListener.Rx.Analyzers/bin/$(Configuration)/netstandard2.0/SimpleHttpListener.Rx.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../SimpleHttpListener.Rx.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/SimpleHttpListener.Rx.Analyzers.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleHttpListener.Rx.Tests" />
  </ItemGroup>

</Project>
